{
  "name": "plan-viz-mcp",
  "version": "0.1.1",
  "description": "Visualize DataFusion execution plans as Excalidraw scenes and PNGs over MCP",
  "license": "MIT",
  "author": {
    "name": "NGA-TRAN"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "plan-viz-mcp": "dist/stdio.js"
  },
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "dist",
    "docs"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "datafusion",
    "execution-plan",
    "excalidraw",
    "visualization",
    "png"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NGA-TRAN/plan_viz_mcp.git"
  },
  "bugs": {
    "url": "https://github.com/NGA-TRAN/plan_viz_mcp/issues"
  },
  "homepage": "https://github.com/NGA-TRAN/plan_viz_mcp#readme",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-renderer.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --exclude '**/png.integration.test.ts'",
    "test:png": "vitest run tests/png.integration.test.ts",
    "test:package": "node scripts/smoke-package.mjs",
    "benchmark:png": "node scripts/benchmark-png.mjs",
    "start": "node dist/stdio.js",
    "start:http": "node dist/http.js",
    "prepack": "npm run build"
  },
  "overrides": {
    "@excalidraw/excalidraw": {
      "nanoid": "3.3.19"
    },
    "@excalidraw/mermaid-to-excalidraw": {
      "nanoid": "5.1.16"
    },
    "lodash-es": "4.18.1"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "plan-viz": "0.1.23",
    "playwright": "1.63.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@excalidraw/excalidraw": "0.18.1",
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "26.6.2",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "pngjs": "7.0.0",
    "prettier": "3.9.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.1"
  }
}
